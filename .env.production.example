# EC2 public IPv4 address or domain name, without http:// or a trailing slash.
PUBLIC_HOST=203.0.113.10

# Use different strong random values for these two passwords.
DB_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password

# Optional integrations. The app starts without these, but the related feature is unavailable.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
SWEET_TRACKER_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
