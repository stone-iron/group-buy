{$PUBLIC_HOST} {
    encode zstd gzip

    @backend path /api/* /ws/* /oauth2/* /login/*
    handle @backend {
        reverse_proxy backend:8080
    }

    handle_path /hls/* {
        reverse_proxy mediamtx:8888 {
            header_down Location "^/(.*)$" "/hls/$1"
        }
    }

    handle {
        reverse_proxy frontend:3000
    }
}
